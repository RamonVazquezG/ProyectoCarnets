@model ProyectoCarnets.Models.Carnet

@{
    ViewData["Title"] = "Eliminar Carnet";
}

<h2>@ViewData["Title"]</h2>

<h4>¿Está seguro que desea eliminar este carnet?</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Alumno</dt>
        <dd class="col-sm-10">@Model.Alumno?.Nombre</dd>

        <dt class="col-sm-2">Programa</dt>
        <dd class="col-sm-10">@Model.ProgramaEducativo?.NombrePrograma</dd>

        <dt class="col-sm-2">Actividad</dt>
        <dd class="col-sm-10">@Model.ActividadComplementaria?.NombreActividad</dd>

        <dt class="col-sm-2">Fecha de registro</dt>
        <dd class="col-sm-10">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
