@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="text-center">
    <h1 class="display-4">Administración de Carnets</h1>
    <p>Selecciona una tabla para visualizar los datos.</p>
</div>

<div class="btn-group d-flex justify-content-center mb-4" role="group">
    <button type="button" class="btn btn-outline-primary" onclick="cargarTabla('GetTablaAlumnos')">Ver Alumnos</button>
    <button type="button" class="btn btn-outline-success" onclick="cargarTabla('GetTablaProgramas')">Ver Programas</button>
    <button type="button" class="btn btn-outline-secondary" onclick="cargarTabla('GetActividadesComplementarias')">Ver Actividades Complementarias</button>
    <button type="button" class="btn btn-outline-dark" onclick="cargarTabla('GetTablaCarnets')">Ver Carnets Capturados</button>
</div>

<div id="contenedor-tabla" class="border p-3 shadow-sm rounded" style="min-height: 200px;">
    <div class="text-muted text-center mt-5">Selecciona una opción arriba para comenzar</div>
</div>

@section Scripts {
    <script>

        function cargarTabla(accion) {
            document.getElementById('contenedor-tabla').innerHTML =
                '<div class="text-center p-4"><div class="spinner-border"></div><p>Cargando...</p></div>';

            fetch('/Admin/' + accion)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('contenedor-tabla').innerHTML = html;
                });
        }

        document.addEventListener("click", function (e) {

            if (e.target.classList.contains("btnBuscarAlumno")) {
                let matricula = document.getElementById("txtMatricula").value.trim();

                fetch(`/Admin/BuscarAlumnos?matricula=${encodeURIComponent(matricula)}`)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById("contenedor-tabla").innerHTML = html;
                    });
            }

            if (e.target.classList.contains("btnLimpiarAlumno")) {
                fetch(`/Admin/GetTablaAlumnos`)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById("contenedor-tabla").innerHTML = html;
                    });
            }

                  if (e.target.classList.contains("btnBuscarCarnet")) {
            let matricula = document.getElementById("txtBuscarMatriculaCarnet").value.trim();

            fetch(`/Admin/GetTablaCarnets?search=${encodeURIComponent(matricula)}`)
                .then(r => r.text())
                .then(html => {
                    document.getElementById("contenedor-tabla").innerHTML = html;
                });
        }

              if (e.target.classList.contains("btnLimpiarCarnet")) {
                 fetch(`/Admin/GetTablaCarnets`)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById("contenedor-tabla").innerHTML = html;
                    });
        }

        });

    </script>
}