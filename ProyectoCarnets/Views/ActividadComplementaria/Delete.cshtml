@model ProyectoCarnets.Models.ActividadComplementaria

@{
    ViewData["Title"] = "Eliminar Actividad";
}

<div class="container mt-4">
    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="fa fa-exclamation-triangle"></i> Eliminar Actividad Complementaria</h4>
        </div>

        <div class="card-body">
            <h5 class="card-title text-center text-danger mb-4">¿Está seguro de que desea eliminar esta actividad?</h5>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th class="bg-light" style="width: 30%">Clave:</th>
                                <td>@Model.Clave</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Nombre de Actividad:</th>
                                <td>@Model.NombreActividad</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-center mt-3 gap-3">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Clave" />

                    <button type="submit" class="btn btn-danger btn-lg px-4">
                        <i class="fa fa-trash"></i> Confirmar Eliminación
                    </button>
                </form>

                <a asp-controller="Carnets" asp-action="Index" class="btn btn-secondary btn-lg px-4 ms-2">
                    Cancelar
                </a>
            </div>

        </div>
    </div>
</div>