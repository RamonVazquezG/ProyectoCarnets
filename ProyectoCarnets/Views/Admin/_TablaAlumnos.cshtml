@model IEnumerable<ProyectoCarnets.Models.Alumno>

<h3>Listado de Alumnos</h3>

<a asp-controller="Alumnos" asp-action="Create" class="btn btn-success mb-3">
    Registrar Alumnos
    </a>

<div class="input-group mb-3" style="max-width: 450px;">
    <input type="text"
           id="txtMatricula"
           class="form-control"
           placeholder="Buscar por matrícula..."
           value="@ViewBag.Search" />
    <button class="btn btn-primary btnBuscarAlumno">Buscar</button>
    <button class="btn btn-secondary btnLimpiarAlumno">Limpiar</button>
</div>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Matrícula</th>
            <th>Nombre</th>
            <th>Apellido Paterno</th>
            <th>Apellido Materno</th>
            <th>Etapa</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Matricula</td>
                <td>@item.Nombre</td>
                <td>@item.ApellidoPaterno</td>
                <td>@item.ApellidoMaterno</td>
                <td>@item.Etapa</td>
                <td>
                    <a asp-controller="Alumnos" asp-action="Edit" asp-route-id="@item.Matricula" class="btn btn-sm btn-primary">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>