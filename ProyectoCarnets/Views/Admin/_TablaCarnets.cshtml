@model IEnumerable<ProyectoCarnets.Models.Carnet>

<h3>Listado de Carnets</h3>

<a asp-controller="Carnets" asp-action="Create" class="btn btn-success mb-3">
    Registrar Carnet
</a>

<div class="input-group mb-3" style="max-width: 450px;">
    <input type="text"
           id="txtBuscarMatriculaCarnet"
           class="form-control"
           placeholder="Buscar por matrícula..."
           value="@ViewBag.Search" />

    <button class="btn btn-primary btnBuscarCarnet">Buscar</button>
    <button class="btn btn-secondary btnLimpiarCarnet">Limpiar</button>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Alumno</th>
            <th>Programa</th>
            <th>Actividad</th>
            <th>Fecha Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Alumno.Nombre (@item.Alumno.Matricula)</td>
                <td>@item.ProgramaEducativo.NombrePrograma</td>
                <td>@item.ActividadComplementaria.Clave</td>
                <td>@item.FechaRegistro.ToShortDateString()</td>
                <td>
                    <a asp-controller="Carnets" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                    <a asp-controller="Carnets" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>