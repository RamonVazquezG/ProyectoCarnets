@model ProyectoCarnets.Models.ProgramaEducativo

@{
    ViewData["Title"] = "Registrar Programa Educativo";
}

<h2 class="mb-4 text-center">Registrar Programa Educativo</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Clave" class="form-label">Clave</label>
                <input asp-for="Clave" class="form-control" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NombrePrograma" class="form-label">Nombre del Programa</label>
                <input asp-for="NombrePrograma" class="form-control" />
                <span asp-validation-for="NombrePrograma" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Registrar</button>
                <a asp-controller="Carnets" asp-action="Index" class="btn btn-secondary">Cancelar</a>

            </div>
        </form>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["MensajeExito"]
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
